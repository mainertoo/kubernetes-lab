[Unit]
Description=AirConnect airupnp (AirPlay -> UPnP bathroom fan speakers)
Wants=network-online.target
After=network-online.target nftables.service

[Service]
User=airconnect
Group=airconnect
ExecStart=/usr/local/bin/airupnp -Z -k -b eth0:49152 -x /etc/airconnect/config.xml
Restart=always
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
